{
  "name": "sql-canvas/sql-canvas",
  "description": "See your database differently: a visual-first, self-hosted MySQL and MariaDB workspace.",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.2",
    "ext-json": "*",
    "ext-pdo": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "SqlCanvas\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "SqlCanvas\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "lint": "@php tools/php-lint.php"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": false
  }
}

